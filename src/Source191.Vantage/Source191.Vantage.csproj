<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Source191.Vantage</RootNamespace>
    <AssemblyName>vantage</AssemblyName>
    <Version>0.20.0-preview.31</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Authors>Simon Vane</Authors>
    <Description>Mission control for Claude Code sessions: every session in one tab, still there after a reboot.</Description>
    <Copyright>Copyright 2026 Simon Vane</Copyright>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\icon\vantage.ico" Link="vantage.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Source191.Vantage.Core\Source191.Vantage.Core.csproj" />
    <ProjectReference Include="..\Source191.Vantage.Infrastructure\Source191.Vantage.Infrastructure.csproj" />
    <ProjectReference Include="..\Source191.Vantage.Tui\Source191.Vantage.Tui.csproj" />
  </ItemGroup>

</Project>